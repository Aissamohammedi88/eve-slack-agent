# ─── RÉSILIENCE & PERFORMANCE (Senior Override) ───────────────────────────────

# 1. Timeouts (Empêche l'agent de bloquer indéfiniment)
OLLAMA_TIMEOUT=60
SLACK_ACK_TIMEOUT=3

# 2. Gestion du contexte (Empêche Ollama de saturer la RAM)
OLLAMA_MAX_CONTEXT=4096
OLLAMA_TEMPERATURE=0.7

# 3. Retry (Si Ollama ou Slack échoue, on réessaie)
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# 4. Mode Debug (Affiche les payloads)
DEBUG_PAYLOADS=false
