# ─── 1. APPLICATION CORE ──────────────────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=3000
LOG_LEVEL=info
# Génère une clé locale pour signer les sessions (pas d'API, juste du local)
JWT_SECRET=change-me-with-openssl-rand-hex-32

# ─── 2. SLACK INTEGRATION (Le seul "compte" requis) ──────────────────────────
# Récupérer sur https://api.slack.com/apps (Gratuit)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ─── 3. LLM PROVIDERS (Le Cerveau d'Eve - 100% Local) ────────────────────────

# Ollama (Local, 100% gratuit, aucune clé API)
# Assure-toi que Ollama tourne sur ta machine (commande: ollama serve)
# Modèles recommandés : llama3.2, mistral, qwen2.5-coder
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── 4. OUTILS OPEN SOURCE (Sans clé API) ────────────────────────────────────

# Pollinations.ai (Génération d'images/textes open source)
# API gratuite, aucune clé requise pour l'usage de base
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt/

# Si tu utilises un routeur local (ex: LiteLLM ou OpenRouter local)
# LITELLM_BASE_URL=http://localhost:4000

# ─── 5. MÉMOIRE & STOCKAGE (Local) ───────────────────────────────────────────
# Base de données locale
DATABASE_URL=sqlite:///./eve_memory.db
# Cache local (si tu utilises Redis en local, sinon laisse commenté)
# REDIS_URL=redis://localhost:6379/0

# Dossier de travail pour les fichiers générés par l'agent
WORKSPACE_DIR=agent_workspace
# ─── 6. OBSERVABILITÉ (Local) ────────────────────────────────────────────────
# Si tu utilises LangSmith en local (ou Langfuse open source)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=http://localhost:8000
