# ═══════════════════════════════════════════════════════════════════════════════
# EVE-SLACK-AGENT — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════════
# Auteur : Aissa Mohammedi (DGK) — NEXUS-OPEN-3.0
# ATTENTION : Ne jamais committer ce fichier. Il est dans le .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. CONFIGURATION SLACK (Obligatoire) ─────────────────────────────────────
# Récupérer sur https://api.slack.com/apps -> Ton App -> OAuth & Permissions
# Le Bot Token commence par xoxb-
SLACK_BOT_TOKEN="xoxb-ton-token-ici"

# Récupérer sur https://api.slack.com/apps -> Ton App -> Basic Information -> App-Level Tokens
# Le App Token commence par xapp- (nécessaire pour Socket Mode)
SLACK_APP_TOKEN="xapp-ton-token-ici"

# Récupérer sur https://api.slack.com/apps -> Ton App -> Basic Information -> App Credentials
SLACK_SIGNING_SECRET="ton-signing-secret-ici"


# ─── 2. CONFIGURATION IA (Obligatoire pour Eve) ───────────────────────────────
# Choisir le provider principal : openai, anthropic, ou local
AI_PROVIDER="openai"

# Si OpenAI (commence par sk-)
OPENAI_API_KEY="sk-ton-token-openai"

# Si Anthropic / Claude (commence par sk-ant-)
ANTHROPIC_API_KEY=""

# Modèle par défaut à utiliser pour Eve
AI_MODEL="gpt-4o"
AI_TEMPERATURE="0.7"
AI_MAX_TOKENS="2048"


# ─── 3. BASE DE DONNÉES & MÉMOIRE ─────────────────────────────────────────────
# Si Eve utilise PostgreSQL pour la mémoire à long terme
DATABASE_URL="postgresql://eve_user:mot_de_passe@localhost:5432/eve_db"

# Si Eve utilise Redis pour le cache ou les sessions
REDIS_URL="redis://localhost:6379/0"

# Alternative : SQLite local (décommenter si utilisé)
# DATABASE_URL="sqlite:///./eve_memory.db"


# ─── 4. CONFIGURATION APPLICATION ─────────────────────────────────────────────
# Environnement : development, staging, production
APP_ENV="development"
APP_NAME="Eve"
APP_PORT="3000"
APP_HOST="0.0.0.0"

# Niveau de log : debug, info, warn, error
LOG_LEVEL="info"

# Clé secrète pour signer les sessions ou les payloads
# Générer avec : openssl rand -hex 32
APP_SECRET_KEY="une-chaine-aleatoire-de-32-caracteres"


# ─── 5. SÉCURITÉ & OUTILS (Optionnel) ─────────────────────────────────────────
# Token pour les APIs internes de NEXUS (si Eve doit communiquer avec ton écosystème)
NEXUS_API_TOKEN=""

# URL du webhook (si Eve doit envoyer des rapports ailleurs)
WEBHOOK_URL=""

# Si tu utilises LangSmith pour tracer les actions de l'IA (optionnel)
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="eve-slack-agent"
