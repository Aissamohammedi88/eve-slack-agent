# ═══════════════════════════════════════════════════════════════════════════════
# EVE-SLACK-AGENT — MULTI-PROVIDER ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# ATTENTION : Ne jamais committer ce fichier. Il doit être dans le .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. APPLICATION CORE ──────────────────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=3000
LOG_LEVEL=info
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ─── 2. SLACK INTEGRATION (Obligatoire) ──────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ─── 3. LES GÉANTS (APIs Propriétaires) ──────────────────────────────────────

# --- Anthropic (Claude) ---
# Obtenir sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-votre-cle-claude-ici
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- OpenAI (GPT) ---
# Obtenir sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-votre-cle-openai-ici
OPENAI_MODEL=gpt-4o

# --- Google (Gemini) ---
# Obtenir sur : https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=votre-cle-google-ici
GOOGLE_MODEL=gemini-1.5-pro-latest

# --- Mistral AI (Le géant européen) ---
# Obtenir sur : https://console.mistral.ai/
MISTRAL_API_KEY=votre-cle-mistral-ici
MISTRAL_MODEL=mistral-large-latest

# ─── 4. OPEN SOURCE & LOCAL (Zéro Coût) ──────────────────────────────────────

# --- Ollama (Inférence 100% Locale) ---
# Aucune clé API nécessaire. Il suffit d'avoir Ollama installé sur ta machine.
# Télécharger sur : https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Autres modèles : mistral, qwen, deepseek-coder, etc.

# --- Pollinations.ai (API Open Source / Freemium) ---
# Pollinations fournit un accès gratuit (sans clé stricte) pour le texte et les images.
# Pour éviter le rate-limit, tu peux obtenir un token sur : https://pollinations.ai/
POLLINATIONS_BASE_URL=https://text.pollinations.ai
POLLINATIONS_TOKEN=votre-token-pollinations-optionnel

# --- Hugging Face (Hub de modèles open source) ---
# Obtenir sur : https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_votre-cle-huggingface-ici

# --- Groq (Inférence ultra-rapide sur modèles open source) ---
# Obtenir sur : https://console.groq.com/keys
GROQ_API_KEY=gsk_votre-cle-groq-ici
GROQ_MODEL=llama-3.3-70b-versatile

# ─── 5. CONFIGURATION DU ROUTEUR (Cerveau d'Eve) ─────────────────────────────
# Le provider par défaut si Eve ne sait pas quoi choisir
DEFAULT_PROVIDER=anthropic

# Stratégie de fallback : si Anthropic tombe, on passe à OpenAI, puis Ollama.
FALLBACK_PROVIDERS=openai,google,ollama

# ─── 6. MÉMOIRE & STOCKAGE ───────────────────────────────────────────────────
DATABASE_URL=postgresql://eve_user:password@localhost:5432/eve_db
REDIS_URL=redis://localhost:6379/0
WORKSPACE_DIR=agent_workspace

# ─── 7. OBSERVABILITÉ ────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=eve-slack-agent
