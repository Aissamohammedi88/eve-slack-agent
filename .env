# ═══════════════════════════════════════════════════════════════════════════════
# EVE-SLACK-AGENT — PRODUCTION-GRADE ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Inspiré par les standards des stacks d'agents open-source.
# ATTENTION : Ne jamais committer ce fichier. Il doit être dans le .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. APPLICATION CORE ──────────────────────────────────────────────────────
# Environnement : development, staging, production
NODE_ENV=development
# Port sur lequel le serveur de l'agent écoute
SERVER_PORT=3000
# Niveau de log : debug, info, warn, error
LOG_LEVEL=info
# Format du log : pretty, json
LOG_FORMAT=pretty
# Clé secrète pour signer les sessions/JWT. Générer avec: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ─── 2. SLACK INTEGRATION (Obligatoire) ──────────────────────────────────────
# Récupérer sur https://api.slack.com/apps
# Bot User OAuth Token (commence par xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# App-Level Token (commence par xapp-), nécessaire pour Socket Mode
SLACK_APP_TOKEN=xapp-your-app-level-token-here
# Signing Secret pour vérifier l'authenticité des requêtes
SLACK_SIGNING_SECRET=your-signing-secret-here

# ─── 3. LLM PROVIDERS (Cœur de l'agent Eve) ──────────────────────────────────
# Fournisseur par défaut : openai | anthropic | google | groq | ollama | openrouter
LLM_PROVIDER=openai

# --- OpenAI (commence par sk-) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
# Modèle par défaut (ex: gpt-4o, gpt-4-turbo)
OPENAI_MODEL=gpt-4o

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Google Gemini ---
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_MODEL=gemini-1.5-pro-latest

# --- Groq (pour des réponses ultra-rapides) ---
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (accès à des centaines de modèles) ---
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# --- Ollama (pour l'inférence locale) ---
# OLLAMA_BASE_URL=http://localhost:11434

# Paramètres de génération (optionnel, remplace les défauts du modèle)
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=2048

# ─── 4. MÉMOIRE & STOCKAGE (Optionnel, pour la persistance) ───────────────────
# Si Eve utilise une base de données pour se souvenir des conversations
# DATABASE_URL=postgresql://eve_user:password@localhost:5432/eve_db
# Si Eve utilise Redis pour le cache ou les sessions
# REDIS_URL=redis://localhost:6379/0
# Dossier de travail pour les fichiers générés par l'agent
WORKSPACE_DIR=agent_workspace

# ─── 5. OBSERVABILITÉ & TRACING (Recommandé pour le debug) ────────────────────
# LangSmith (si tu utilises LangChain/LangGraph pour tracer les appels LLM)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
# LANGCHAIN_PROJECT=eve-slack-agent
# Helix (si tu utilises un autre traceur)
# HELICONE_API_KEY=your-helicone-key-here

# ─── 6. OUTILS & INTÉGRATIONS AVANCÉES ───────────────────────────────────────
# Serveur MCP (Model Context Protocol) pour étendre les capacités d'Eve
# MCP_SERVER_URL=http://localhost:8000
# Token pour les APIs internes de ton écosystème NEXUS
# NEXUS_API_TOKEN=your-nexus-token-here
