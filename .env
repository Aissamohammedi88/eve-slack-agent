# ═══════════════════════════════════════════════════════════════════════════════
# EVE-SLACK-AGENT — SENIOR LOCAL ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════════
# Auteur : Aissa Mohammedi (DGK) — NEXUS-OPEN-3.0
# ATTENTION : Ne jamais committer ce fichier. Il est dans le .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. APPLICATION CORE ──────────────────────────────────────────────────────
# Environnement : development, staging, production
NODE_ENV=development
# Port d'écoute (doit correspondre à ton tunnel ngrok/cloudflare si utilisé)
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
# Niveau de log : debug, info, warn, error
LOG_LEVEL=info
# Secret JWT (Générer avec: openssl rand -hex 32)
JWT_SECRET=change-me-with-openssl-rand-hex-32

# ─── 2. SLACK INTEGRATION (Obligatoire pour le bot) ──────────────────────────
# Récupérer sur https://api.slack.com/apps
# 1. Bot User OAuth Token (commence par xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# 2. App-Level Token (commence par xapp-) - OBLIGATOIRE pour Socket Mode
SLACK_APP_TOKEN=xapp-your-app-level-token-here
# 3. Signing Secret (pour vérifier les requêtes)
SLACK_SIGNING_SECRET=your-signing-secret-here

# ─── 3. LLM PROVIDERS (Le Cerveau d'Eve - 100% Local) ────────────────────────

# --- Ollama (Local) ---
# Assure-toi que Ollama tourne (commande: ollama serve)
OLLAMA_HOST=http://127.0.0.1:11434
# Modèle par défaut (doit être téléchargé: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
# Timeout pour les réponses longues (en secondes)
OLLAMA_TIMEOUT=120


# --- Pollinations (Génération d'images Open Source) ---
# API gratuite, aucune clé requise
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt/
# Modèle de génération d'image (ex: flux, turbo)
POLLINATIONS_MODEL=flux


# ─── 4. BASE DE DONNÉES (SQLite Local) ───────────────────────────────────────
# Utilisation d'un chemin absolu pour éviter les erreurs de CWD
# Le chemin sera résolu par rapport au dossier du projet
DATABASE_URL=sqlite+aiosqlite:///./eve_memory.db
# Si tu as Redis en local, décommente :
# REDIS_URL=redis://127.0.0.1:6379/0

# Dossier de travail pour les fichiers générés par l'agent
WORKSPACE_DIR=./agent_workspace

# ─── 5. OBSERVABILITÉ ────────────────────────────────────────────────────────
# Décommente si tu utilises Langfuse ou LangSmith en local
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT=http://127.0.0.1:8000
