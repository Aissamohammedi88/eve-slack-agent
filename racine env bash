class ModelClient:
"""Client universel multi-modèle avec fallback"""

def __init__(self):
self.config = self._charger_config()
self.providers = []
self._detecter_providers()

def _charger_config(self) -> Dict:
if CONFIG.exists():
try:
return json.loads(CONFIG.read_text())
except Exception:
pass
return {}

def _detecter_providers(self):
# Détecter selon les clés API présentes
checks = [
("openai", "OPENAI_API_KEY", "https://api.openai.com/v1/chat/completions", "gpt-4o"),
("anthropic", "ANTHROPIC_API_KEY", "https://api.anthropic.com/v1/messages", "claude-3-5-sonnet-20241022"),
("deepseek", "DEEPSEEK_API_KEY", "https://api.deepseek.com/v1/chat/completions", "deepseek-chat"),
("gemini", "GEMINI_API_KEY", "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent", "gemini-1.5-flash"),
("groq", "GROQ_API_KEY", "https://api.groq.com/openai/v1/chat/completions", "llama-3.3-70b-versatile"),
]
for name, env_key, url, default_model in checks:
if os.environ.get(env_key):
self.providers.append({
"name": name,
"key": os.environ[env_key],
"url": url,
"model": default_model,
})

# Ollama local (toujours disponible si lancé)
try:
req = urllib.request.Request("http://localhost:11434/api/tags", method="GET")
with urllib.request.urlopen(req, timeout=2) as r:
if r.status == 200:
self.providers.append({
"name": "ollama",
"url": "http://localhost:11434/api/chat",
"model": "llama3.2",
})
except Exception:
pass

def chat(self, messages: List[Dict], tools: List[Dict] = None) -> Dict:
if not self.providers:
return {
"error": "Aucun provider configuré",
"hint": "Définis OPENAI_API_KEY ou ANTHROPIC_API_KEY ou démarre Ollama",
"mode": "offline"
}

for provider in self.providers:
try:
return self._call(provider, messages, tools)
except Exception as e:
warn(f"Provider {provider['name']} échoué : {e}")
continue

return {"error": "Tous les providers ont échoué"}

def _call(self, provider: Dict, messages: List[Dict], tools: List[Dict] = None) -> Dict:
if provider["name"] == "anthropic":
return self._call_anthropic(provider, messages, tools)
elif provider["name"] == "gemini":
return self._call_gemini(provider, messages, tools)
elif provider["name"] == "ollama":
return self._call_ollama(provider, messages)
else:
return self._call_openai_compatible(provider, messages, tools)

def _call_openai_compatible(self, provider, messages, tools):
body = {
"model": provider["model"],
"messages": messages,
"temperature": 0.7,
}
if tools:
body["tools"] = tools

req = urllib.request.Request(
provider["url"],
data=json.dumps(body).encode(),
headers={
"Content-Type": "application/json",
"Authorization": f"Bearer {provider['key']}",
},
method="POST",
)

with urllib.request.urlopen(req, timeout=60) as r:
data = json.loads(r.read().decode())
choice = data.get("choices", [{}])[0]
msg = choice.get("message", {})
return {
"role": "assistant",
"content": msg.get("content", ""),
"tool_calls": msg.get("tool_calls", []),
"provider": provider["name"],
"model": provider["model"],
}

def _call_anthropic(self, provider, messages, tools):
body = {
"model": provider["model"],
"max_tokens": 4096,
"messages": [m for m in messages if m["role"] != "system"],
}
if tools:
body["tools"] = tools

req = urllib.request.Request(
provider["url"],
data=json.dumps(body).encode(),
headers={
"Content-Type": "application/json",
"x-api-key": provider["key"],
"anthropic-version": "2023-06-01",
},
method="POST",
)

with urllib.request.urlopen(req, timeout=60) as r:
data = json.loads(r.read().decode())
content_blocks = data.get("content", [])
text = "".join(b.get("text", "") for b in content_blocks if b.get("type") == "text")
return {
"role": "assistant",
"content": text,
"provider": "anthropic",
"model": provider["model"],
}

def _call_gemini(self, provider, messages, tools):
# Format simplifié
contents = []
for m in messages:
if m["role"] == "system":
continue
contents.append({
"role": "user" if m["role"] == "user" else "model",
"parts": [{"text": m["content"]}],
})

url = f"{provider['url']}?key={provider['key']}"
body = {"contents": contents}

req = urllib.request.Request(
url,
data=json.dumps(body).encode(),
headers={"Content-Type": "application/json"},
method="POST",
)

with urllib.request.urlopen(req, timeout=60) as r:
data = json.loads(r.read().decode())
try:
text = data["candidates"][0]["content"]["parts"][0]["text"]
except (KeyError, IndexError):
text = ""
return {
"role": "assistant",
"content": text,
"provider": "gemini",
"model": provider["model"],
}

def _call_ollama(self, provider, messages):
body = {
"model": provider["model"],
"messages": messages,
"stream": False,
}
req = urllib.request.Request(
provider["url"],
data=json.dumps(body).encode(),
headers={"Content-Type": "application/json"},
method="POST",
)
with urllib.request.urlopen(req, timeout=120) as r:
data = json.loads(r.read().decode())
return {
"role": "assistant",
"content": data.get("message", {}).get("content", ""),
"provider": "ollama",
"model": provider["model"],
}


