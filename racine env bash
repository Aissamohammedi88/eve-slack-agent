},
},
},
]

def execute(self, name: str, args: Dict) -> Any:
if name == "run_bash":
return self.executor.run_bash(args["script"], args.get("timeout", 30))
if name == "run_python":
return self.executor.run_python(args["script"], args.get("timeout", 30))
if name == "run_node":
return self.executor.run_node(args["script"], args.get("timeout", 30))
if name == "read_file":
try:
return Path(args["path"]).read_text(encoding="utf-8")[:10000]
except Exception as e:
return {"error": str(e)}
if name == "write_file":
try:
p = Path(args["path"])
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(args["content"], encoding="utf-8")
return {"success": True, "bytes": len(args["content"])}
except Exception as e:
return {"error": str(e)}
if name == "remember":
self.memory.remember(args["key"], args["value"])
return {"success": True}
if name == "recall":
return self.memory.recall(args["key"]) or "(non trouvé)"
if name == "web_fetch":
try:
req = urllib.request.Request(args["url"], headers={"User-Agent": "NexusAgent/1.0"})
with urllib.request.urlopen(req, timeout=15) as r:
return r.read(20000).decode("utf-8", errors="ignore")
except Exception as e:
return {"error": str(e)}
return {"error": f"Tool inconnu : {name}"}


