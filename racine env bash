class Memory:
def __init__(self):
MEMORY_DB.parent.mkdir(parents=True, exist_ok=True)
self.conn = sqlite3.connect(str(MEMORY_DB), check_same_thread=False)
self._init()

def _init(self):
c = self.conn.cursor()
c.execute("""
CREATE TABLE IF NOT EXISTS messages (
id INTEGER PRIMARY KEY AUTOINCREMENT,
role TEXT,
content TEXT,
timestamp TEXT,
session TEXT
)
""")
c.execute("""
CREATE TABLE IF NOT EXISTS facts (
id INTEGER PRIMARY KEY AUTOINCREMENT,
key TEXT UNIQUE,
value TEXT,
timestamp TEXT
)
""")
c.execute("""
CREATE TABLE IF NOT EXISTS tasks (
id INTEGER PRIMARY KEY AUTOINCREMENT,
description TEXT,
status TEXT,
result TEXT,
created TEXT,
completed TEXT
)
""")
self.conn.commit()

def add_message(self, role: str, content: str, session: str = "default"):
c = self.conn.cursor()
c.execute("INSERT INTO messages (role, content, timestamp, session) VALUES (?,?,?,?)",
(role, content, datetime.now(timezone.utc).isoformat(), session))
self.conn.commit()

def get_history(self, session: str = "default", limit: int = 20) -> List[Dict]:
c = self.conn.cursor()
c.execute("SELECT role, content FROM messages WHERE session=? ORDER BY id DESC LIMIT ?",
(session, limit))
rows = c.fetchall()
return [{"role": r[0], "content": r[1]} for r in reversed(rows)]

def remember(self, key: str, value: str):
c = self.conn.cursor()
c.execute("INSERT OR REPLACE INTO facts (key, value, timestamp) VALUES (?,?,?)",
(key, value, datetime.now(timezone.utc).isoformat()))
self.conn.commit()

def recall(self, key: str) -> Optional[str]:
c = self.conn.cursor()
c.execute("SELECT value FROM facts WHERE key=?", (key,))
row = c.fetchone()
return row[0] if row else None

def all_facts(self) -> Dict[str, str]:
c = self.conn.cursor()
c.execute("SELECT key, value FROM facts ORDER BY id DESC")
return dict(c.fetchall())


