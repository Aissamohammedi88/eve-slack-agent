# AGENT PRINCIPAL
# ═══════════════════════════════════════════════════════════════════════════
class NexusAgent:
def __init__(self):
self.memory = Memory()
self.executor = CodeExecutor()
self.skills = SkillManager()
self.model = ModelClient()
self.tools = ToolRegistry(self.executor, self.memory)
self.session = "default"

def system_prompt(self) -> str:
return f"""Tu es NEXUS, un agent autonome conçu par Aissa Mohammedi (DGK).

Tu n'es PAS un simple chatbot. Tu AGIS.

CAPACITÉS :
- Exécuter du code (bash, python, node)
- Lire/écrire des fichiers
- Mémoriser des faits entre les sessions
- Chercher sur le web
- Itérer jusqu'à ce que la tâche soit COMPLÈTE

RÈGLES :
1. Ne dis JAMAIS "je ne peux pas" sans avoir essayé un tool
2. Si une approche échoue, essaie une autre
3. Vérifie ton travail avec run_bash/run_python
4. Sois concis mais complet
5. Signe les réponses complexes : — NEXUS (DGK)

Skills disponibles : {', '.join(self.skills.list_skills())}
Faits mémorisés : {json.dumps(self.memory.all_facts(), ensure_ascii=False)[:500]}

Aujourd'hui : {datetime.now().strftime('%Y-%m-%d %H:%M')}
"""

def chat(self, message: str, max_iterations: int = 5) -> str:
self.memory.add_message("user", message, self.session)

history = self.memory.get_history(self.session, 10)
messages = [{"role": "system", "content": self.system_prompt()}] + history

for iteration in range(max_iterations):
info(f"Itération {iteration + 1}/{max_iterations}")

response = self.model.chat(messages, tools=self.tools.tools)

if "error" in response:
err(f"Erreur modèle : {response['error']}")
if "hint" in response:
info(response["hint"])
return response.get("hint", "Aucun modèle disponible")

# Si pas de tool call → réponse finale
tool_calls = response.get("tool_calls", [])
if not tool_calls:
content = response.get("content", "")
self.memory.add_message("assistant", content, self.session)
return content

# Exécuter les tool calls
messages.append({
"role": "assistant",
"content": response.get("content", ""),
"tool_calls": tool_calls,
})

for tc in tool_calls:
fn = tc.get("function", {})
name = fn.get("name")
try:
args = json.loads(fn.get("arguments", "{}"))
except Exception:
args = {}

info(f"Tool : {name}({json.dumps(args, ensure_ascii=False)[:80]})")

result = self.tools.execute(name, args)

messages.append({
"role": "tool",
"tool_call_id": tc.get("id", "call_1"),
"content": json.dumps(result, ensure_ascii=False, default=str)[:8000],
})

return "(max itérations atteint)"


# ═══════════════════════════════════════════════════════════════════════════
# CLI
# ═══════════════════════════════════════════════════════════════════════════
def cli():
agent = NexusAgent()

print(f"\n{C.M}{C.W}🧬 NEXUS AGENT — v{VERSION}{C.N}")
print(f"{C.D}Provider : ", end="")
if agent.model.providers:
print(f"{C.G}{', '.join(p['name'] for p in agent.model.providers)}{C.N}")
else:
print(f"{C.R}AUCUN{C.N}")
print(f"{C.Y} → export OPENAI_API_KEY=sk-...")
print(f" ou export ANTHROPIC_API_KEY=sk-ant-...")
print(f" ou démarre Ollama local{C.N}\n")

print(f"{C.D}Tape 'exit' pour quitter, 'help' pour l'aide{C.N}\n")

while True:
try:
prompt = input(f"{C.G}➜{C.N} ")
if not prompt.strip():
continue

if prompt.strip().lower() in ("exit", "quit", "q"):
print(f"\n{C.M}👋 NEXUS te dit à bientôt{C.N}\n")
break

if prompt.strip().lower() == "help":
print(f"""
{C.W}Commandes :{C.N}
exit Quitter
help Aide
skills Liste les skills
memory Voir la mémoire
tools Liste les tools
clear Effacer l'historique
config Voir la config

{C.W}Exemples :{C.N}
"écris un script python qui calcule fibonacci"
"installe node et teste une api"
"génère un site web complet"
"debug ce code : [code]"
""")
continue

if prompt.strip().lower() == "skills":
skills = agent.skills.list_skills()
print(f"{C.B}Skills :{C.N} {', '.join(skills)}\n")
continue

if prompt.strip().lower() == "memory":
facts = agent.memory.all_facts()
if facts:
for k, v in facts.items():
print(f" {C.CY}{k}{C.N} = {v}")
else:
print(f" {C.D}(vide){C.N}")
print()
continue

if prompt.strip().lower() == "tools":
for t in agent.tools.tools:
print(f" {C.CY}{t['function']['name']}{C.N} : {t['function']['description'][:60]}")
print()
continue

if prompt.strip().lower() == "clear":
agent.memory.conn.execute("DELETE FROM messages")
agent.memory.conn.commit()
ok("Historique effacé")
continue

if prompt.strip().lower() == "config":
print(json.dumps({
"provider": [p["name"] for p in agent.model.providers],
"skills": agent.skills.list_skills(),
"home": str(HOME),
}, indent=2, ensure_ascii=False))
print()
continue

# Réponse
print()
answer = agent.chat(prompt)
print(f"\n{C.CY}{answer}{C.N}\n")

except KeyboardInterrupt:
print(f"\n{C.M}👋 Interruption{C.N}\n")
break
except EOFError:
break
except Exception as e:
err(f"Erreur : {e}")


if __name__ == "__main__":
cli()
PYEOF

chmod +x "$NEXUS_BIN/nexus.py"
ok "Moteur Python installé : $NEXUS_BIN/nexus.py"
}

