# EXÉCUTEUR DE CODE (le vrai pouvoir)
# ═══════════════════════════════════════════════════════════════════════════
class CodeExecutor:
"""Exécute du code réel dans un sandbox isolé"""

def __init__(self):
SANDBOX.mkdir(parents=True, exist_ok=True)

def run_bash(self, script: str, timeout: int = 30) -> Dict[str, Any]:
return self._run(["bash", "-c", script], timeout)

def run_python(self, script: str, timeout: int = 30) -> Dict[str, Any]:
return self._run(["python3", "-c", script], timeout)

def run_node(self, script: str, timeout: int = 30) -> Dict[str, Any]:
return self._run(["node", "-e", script], timeout)

def run_shell(self, command: str, timeout: int = 30) -> Dict[str, Any]:
try:
args = shlex.split(command)
except Exception:
args = ["bash", "-c", command]
return self._run(args, timeout)

def _run(self, args: List[str], timeout: int) -> Dict[str, Any]:
debut = time.time()
try:
result = subprocess.run(
args,
capture_output=True,
text=True,
timeout=timeout,
cwd=str(SANDBOX),
)
return {
"success": result.returncode == 0,
"stdout": result.stdout[:10000],
"stderr": result.stderr[:2000],
"code": result.returncode,
"duration_ms": int((time.time() - debut) * 1000),
}
except subprocess.TimeoutExpired:
return {"success": False, "error": f"Timeout après {timeout}s"}
except FileNotFoundError as e:
return {"success": False, "error": f"Commande introuvable : {e}"}
except Exception as e:
return {"success": False, "error": str(e)}


